# ReconPilot - Environment Configuration
# See https://docs.reconpilot.dev for more details

# Database
DATABASE_URL=postgresql+asyncpg://reconpilot:${POSTGRES_PASSWORD}@localhost:5432/reconpilot

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json