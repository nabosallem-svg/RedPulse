# RedPulse - Environment Configuration (Production)
# Copy to .env and fill secrets: cp .env.example .env
# See https://docs.RedPulse.dev for more details

# --- Database (asyncpg) ---
# Used by app (async) and alembic (sync, auto-converted to psycopg2). For Docker, host is 'postgres' service name.
DATABASE_URL=postgresql+asyncpg://RedPulse:${POSTGRES_PASSWORD:-RedPulse_secret}@postgres:5432/RedPulse
POSTGRES_PASSWORD=change_me_in_production_postgres_secret

# --- Redis (workers & cache) ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
# For local dev without Docker: REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET=super-secret-jwt-key-change-in-production-must-be-32+chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Environment ---
ENVIRONMENT=production
# Options: development | production | testing
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
LOG_FORMAT=json
# Options: json | text

# --- Telegram Bot (Optional Plugin) ---
# Leave empty to disable Telegram notifications entirely (graceful no-op).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Security — Synthetic findings disabled by default (real scan only) ---
# Never enable in production. Real platform must return empty when nuclei finds 0, not fake.
ALLOW_SYNTHETIC_FINDINGS=0
ENABLE_DEMO_SYNTHETIC=0

# --- Scanner Binaries (configurable paths, AGENTS.md:7) ---
# Override if binaries are installed elsewhere or mounted as volumes.
NUCLEI_BIN=/usr/local/bin/nuclei
# Alias for compatibility with older docs:
NUCLEI_PATH=/usr/local/bin/nuclei
SUBFINDER_BIN=/usr/local/bin/subfinder
HTTPX_BIN=/usr/local/bin/httpx

# --- Scanner Limits ---
SCANNER_MAX_WORKERS=4
SCANNER_TIMEOUT=60

# --- Optional: External Bounty Platforms (if using bug_bounty_program auth) ---
# HACKERONE_API_TOKEN=
# BUGCROWD_API_TOKEN=

# --- Frontend (dynamic NEXT_PUBLIC_API_URL) ---
# Local: http://localhost:8000, Production (Vercel/self-hosted): https://redpulse.dev or https://redpulse-app.vercel.app
# For Docker: passed as build arg NEXT_PUBLIC_API_URL to frontend/Dockerfile (baked at build time, not runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Stripe Billing (test mode) ---
# Get from https://dashboard.stripe.com/test/apikeys and https://dashboard.stripe.com/test/webhooks
# For test mode, use sk_test_... and whsec_...; price IDs from https://dashboard.stripe.com/test/products
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_test_pro_123
STRIPE_PRICE_BUSINESS=price_test_business_123
STRIPE_PRICE_ENTERPRISE=price_test_enterprise_123
# Optional backup alert webhook (Slack/Discord/custom) for critical backup failures
BACKUP_ALERT_WEBHOOK_URL=
# Optional S3 for offsite backups
BACKUP_S3_BUCKET=
